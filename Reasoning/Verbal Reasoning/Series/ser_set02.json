"section_name": "Semantic/Alphabet Series",
"section_type": "FREE_FLOAT",
"questions": [
{
"id": 1,
"type": "MCQ",
"language": {
"en": "Find the next term in the series: A, C, E, G, ?"
},
"options": {
"A": "H",
"B": "I",
"C": "J",
"D": "K"
},
"correct_answer": "B",
"explanation": "The series is formed by skipping one letter each time in the English alphabet: A (+2) C (+2) E (+2) G (+2) I. Option A (H) would be if only one step forward. Option C (J) skips too many. Option D (K) skips even further."
},
{
"id": 2,
"type": "MCQ",
"language": {
"en": "What comes next in the series: Z, X, V, T, ?"
},
"options": {
"A": "R",
"B": "S",
"C": "U",
"D": "Q"
},
"correct_answer": "A",
"explanation": "The series moves backwards by skipping one letter: Z (-2) X (-2) V (-2) T (-2) R. Option B (S) is only one step back. Option C (U) is incorrect direction. Option D (Q) skips extra."
},
{
"id": 3,
"type": "MCQ",
"language": {
"en": "Complete the series: B, D, F, H, J, ?"
},
"options": {
"A": "K",
"B": "L",
"C": "M",
"D": "N"
},
"correct_answer": "B",
"explanation": "Even positioned letters in alphabet: B(2), D(4), F(6), H(8), J(10), next L(12). Option A (K) is odd position. Option C and D go beyond."
},
{
"id": 4,
"type": "MCQ",
"language": {
"en": "Find the missing term: AZ, CX, EV, GT, ?"
},
"options": {
"A": "IR",
"B": "HS",
"C": "JQ",
"D": "KP"
},
"correct_answer": "A",
"explanation": "First letter increases by 2: A,C,E,G,I. Second letter decreases by 2: Z,X,V,T,R. Hence IR. Other options mismatch the pattern in one or both letters."
},
{
"id": 5,
"type": "MCQ",
"language": {
"en": "Which letter will be the 8th to the right of the 12th letter from the left in the English alphabet?"
},
"options": {
"A": "T",
"B": "U",
"C": "V",
"D": "S"
},
"correct_answer": "A",
"explanation": "12th letter from left is L. 8th to its right is T (L+8). Option B is 9th right. Others are nearby mistakes."
},
{
"id": 6,
"type": "MCQ",
"language": {
"en": "Complete the series: AB, CD, EF, GH, ?"
},
"options": {
"A": "IJ",
"B": "HI",
"C": "JK",
"D": "IL"
},
"correct_answer": "A",
"explanation": "Consecutive letter pairs: AB, CD, EF, GH, IJ. Option B and C are incorrect pairs. Option D mixes."
},
{
